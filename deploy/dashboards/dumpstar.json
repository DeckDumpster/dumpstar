{
  "uid": "dumpstar",
  "title": "Dumpstar",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by route",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_server_requests_total{site=\"star.dumpster.cards\"}[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request latency p50 / p95 / p99 by route",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, route) (rate(http_server_request_duration_seconds_bucket{site=\"star.dumpster.cards\"}[5m])))",
          "legendFormat": "p50 {{route}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_server_request_duration_seconds_bucket{site=\"star.dumpster.cards\"}[5m])))",
          "legendFormat": "p95 {{route}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(http_server_request_duration_seconds_bucket{site=\"star.dumpster.cards\"}[5m])))",
          "legendFormat": "p99 {{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Search page latency by depth bucket (p95; 200 ms line)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, page_depth_bucket) (rate(dumpstar_search_page_ms_bucket{site=\"star.dumpster.cards\"}[5m])))",
          "legendFormat": "p95 depth {{page_depth_bucket}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (le, page_depth_bucket) (rate(dumpstar_search_page_ms_bucket{site=\"star.dumpster.cards\"}[5m])))",
          "legendFormat": "p50 depth {{page_depth_bucket}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Search totals time (first page)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, sort) (rate(dumpstar_search_totals_ms_bucket{site=\"star.dumpster.cards\"}[5m])))",
          "legendFormat": "p50 {{sort}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, sort) (rate(dumpstar_search_totals_ms_bucket{site=\"star.dumpster.cards\"}[5m])))",
          "legendFormat": "p95 {{sort}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Error rate (5xx share of requests) by route",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_server_requests_total{site=\"star.dumpster.cards\",status_class=\"5xx\"}[5m])) / sum by (route) (rate(http_server_requests_total{site=\"star.dumpster.cards\"}[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Search rows returned (p50 / p95)",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, paged) (rate(dumpstar_search_rows_bucket{site=\"star.dumpster.cards\"}[5m])))",
          "legendFormat": "p50 {{paged}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, paged) (rate(dumpstar_search_rows_bucket{site=\"star.dumpster.cards\"}[5m])))",
          "legendFormat": "p95 {{paged}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Deploy drain: seconds, completed, refused",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dumpstar_drain_seconds_sum{site=\"star.dumpster.cards\"}",
          "legendFormat": "drain seconds"
        },
        {
          "refId": "B",
          "expr": "dumpstar_drain_completed_total{site=\"star.dumpster.cards\"}",
          "legendFormat": "completed"
        },
        {
          "refId": "C",
          "expr": "dumpstar_drain_refused_total{site=\"star.dumpster.cards\"}",
          "legendFormat": "refused"
        },
        {
          "refId": "D",
          "expr": "dumpstar_drain_inflight_at_start_sum{site=\"star.dumpster.cards\"}",
          "legendFormat": "in flight at start"
        }
      ]
    }
  ]
}
