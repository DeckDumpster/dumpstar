[Unit]
Description=Dumpstar SWU set art and sealed-product pictures (%i): retired, rollback only
# Since sp-m1fuer this unit fetches nothing. The pictures are landed in the lake
# by dumpstar-refresh@%i (source=swu-assets, dataset=set-art|sealed-images, one
# binary part each) and replayed into the data directory by dumpstar-derive@%i,
# so the prod container makes no upstream image fetch. The unit stays, doing
# nothing, only so the nightly order (refresh, derive, catalog-sync, prices) and
# its timer are undisturbed; it is deleted with `catalog-apply --assets` after
# one week of verified nights from the lake.
#
# ROLLBACK of the pictures cutover: `systemctl --user edit dumpstar-catalog-sync@%i`,
# set ExecStart= to the online job —
#   ExecStart=/bin/sh -c 'exec podman exec systemd-dumpstar-%i dumpstar catalog-apply --assets'
# — which fills the same art/ and sealed-images/ directories, byte for byte what
# the derive does.
#
# Since sp-6i11rn this unit no longer builds the catalog. shared.sqlite is derived
# OFFLINE from the lake's raw/: dumpstar-refresh@%i lands the official card pages
# and the tcgcsv prices, dumpstar-derive@%i replays them. What is left here is
# the pictures — set art and sealed-product images from the publishers' image
# hosts, into the data directory — which need the sealed_images rows that derive
# writes, so this runs after it. Nothing in the request path does any of this.
After=network-online.target
After=dumpstar-derive@%i.service
Wants=network-online.target
OnFailure=dumpstar-alert@%n.service

[Service]
Type=oneshot
# A set with no art is alarmed by dumpstar-catalog-check, not here.
ExecStart=/bin/true
TimeoutStartSec=1800
