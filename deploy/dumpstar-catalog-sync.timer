[Unit]
Description=Daily Dumpstar SWU set art and sealed-product pictures (%i)

[Timer]
# 08:00 is DERIVED from dumpstar-derive@.timer, not guessed at: the derive starts
# at 07:00 and may take most of an hour (it replays ~80 payloads and walks ~10k
# printings), and the pictures it names are the ones this job fetches. The
# ordering dependency in the .service is the guarantee; this only decides when
# the day's work is asked for.
OnCalendar=*-*-* 08:00:00 UTC
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target
