[Unit]
Description=Dumpstar hold proxy (%i)
# sp-slm2ib. Owns the origin port the Cloudflare tunnel targets and holds requests while a deploy
# restarts the container behind it. Never restarted by a deploy.
After=network-online.target

[Service]
ExecStart=/bin/sh -c 'exec bash {{REPO_DIR}}/deploy/front.sh %i'
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
